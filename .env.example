# Neon Postgres (projectdata). Kopieer de "pooled" connection string uit het Neon-dashboard
# of laat Vercel deze zetten via de Neon-integratie.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (projectdocumenten). Wordt automatisch gezet als je een Blob-store aan het Vercel-project koppelt;
# lokaal kopieer je hem uit Vercel > Storage > Blob > .env.local.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
